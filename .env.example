# Copy to .env (or export the variable in the shell). `npm run keys` can create the file for you.
# Never commit a real key. This is only for Studionet test accounts.

# Required for `npm run deploy`: an account funded on Studionet (a deployment costs no GEN, but the account must exist).
DEPLOY_KEY=0x

# The Plinth contract that is already deployed on Studionet (used by the front-end and by `npm run live:deployed`).
PLINTH_ADDRESS=0xAbca00A029bdEaF706ed136DAE54bc107A68ac9d
